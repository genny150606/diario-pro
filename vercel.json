{
    "version": 2,
    "rewrites": [
        {
            "source": "/app",
            "destination": "/app.html"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/index.html"
        }
    ]
}